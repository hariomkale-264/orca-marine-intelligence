# ==============================================================================
# ORCA Production & Deployment Environment Variables
# ==============================================================================

# Backend API URL for the frontend (Vercel deployment)
# - If frontend and serverless API are deployed together on Vercel: LEAVE EMPTY (default).
# - If backend is deployed separately (e.g. Render, Railway, Fly.io, Cloud Run):
#   Set this to your deployed backend origin, e.g.:
#   VITE_API_URL=https://orca-backend.onrender.com
VITE_API_URL=

# GEMINI_API_KEY: Required for server-side Gemini AI chat assistant.
# Kept strictly server-side; never exposed to browser.
GEMINI_API_KEY=

# APP_URL: Production URL where the application is hosted (e.g. https://your-project.vercel.app)
# Used for password reset URLs and secure callback redirects.
APP_URL=

# REQUIRE_EMAIL_VERIFICATION: Set to "false" to activate accounts immediately upon signup
# without requiring the 6-digit email OTP verification code.
# Defaults to "true" (6-digit OTP verification).
REQUIRE_EMAIL_VERIFICATION=true

# VITE_GOOGLE_CLIENT_ID: Optional Google OAuth 2.0 Client ID for Google One-Tap Sign In.
# Client-side configuration for Google Identity Services.
VITE_GOOGLE_CLIENT_ID=

# VITE_GOOGLE_MAPS_API_KEY: Optional Google Maps Platform API key or Demo Key for Google Maps Smart Navigation.
# Get a demo key at: https://mapsplatform.google.com/maps-demo-key?utm_campaign=gmp_mcp_codeassist_v1_aistudio
VITE_GOOGLE_MAPS_API_KEY=

# Outbound Email SMTP Configuration (Optional):
# If configured, real 6-digit verification codes and password reset emails are delivered via SMTP.
# If omitted, verification codes are logged to server console and accessible via secure telemetry.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
